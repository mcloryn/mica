# Salin file ini menjadi .env lalu isi kuncinya.
# File .env tidak ikut di-upload ke GitHub (sudah ada di .gitignore).

# Pilih penyedia LLM: gemini, groq, atau ollama
LLM_PROVIDER=gemini

# Ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ambil gratis di https://console.groq.com/keys
GROQ_API_KEY=
