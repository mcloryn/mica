+  // pratinjau kamera (Langkah 38, K1): JPEG biner dari /preview (127.0.0.1, Origin dicek server)
+  // di-decode dengan createImageBitmap lalu digambar ke satu <canvas>; bitmap ditutup setelah
+  // digambar. Tanpa img src atau object URL. Frame yang datang saat frame sebelumnya belum
+  // selesai dibuang. Gambar hanya di memori.
+  const canvas = $("preview_canvas");
+  const ctx = canvas.getContext("2d", { alpha: false });
   previewSocket = new WebSocket(`ws://${location.host}/preview`);
   previewSocket.binaryType = "blob";
   previewSocket.addEventListener("open", () => { window.__micaPreviewReady = true; });
   previewSocket.addEventListener("message", (e) => {
-    const img = $("preview_img");
-    const old = previewUrl;
-    previewUrl = URL.createObjectURL(e.data);
-    img.src = previewUrl;
-    if (old) URL.revokeObjectURL(old);
-    if (view === null || view.camera_ok) {
-      img.hidden = false;
-      $("preview_empty").hidden = true;
-    }
+    if (previewBusy) return; // frame lama dibuang
+    previewBusy = true;
+    createImageBitmap(e.data)
+      .then((bitmap) => {
+        if (canvas.width !== bitmap.width || canvas.height !== bitmap.height) {
+          canvas.width = bitmap.width;
+          canvas.height = bitmap.height;
+        }
+        ctx.drawImage(bitmap, 0, 0);
+        bitmap.close();
+        if (view === null || view.camera_ok) {
+          canvas.hidden = false;
+          $("preview_empty").hidden = true;
+        }
+      })
+      .catch(() => {}) // JPEG rusak: lewati frame ini
+      .finally(() => { previewBusy = false; });
   });
 }
 
